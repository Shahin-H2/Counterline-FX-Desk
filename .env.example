# Copy this file to .env and fill it in there. The server reads .env only; this template is
# committed to Git and is never loaded, so a real key must not be written here.
TWELVE_DATA_API_KEY=

# Set to "confirmed" only after the account includes rights to display the data.
# Twelve Data's free Basic plan is for internal, non-display use.
TWELVEDATA_EXTERNAL_DISPLAY_LICENSE=

# Optional: the credit limits of your plan. The defaults are the Basic plan's.
# TWELVE_DATA_CREDITS_PER_MINUTE=8
# TWELVE_DATA_CREDITS_PER_DAY=800
